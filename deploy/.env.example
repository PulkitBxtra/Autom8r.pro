# Settings for deploy/docker-compose.yml. Copy to deploy/.env (gitignored) and fill in; never
# commit the filled-in file.

# Postgres (the compose stack's own database)
DB_USERNAME=autom8r
DB_PASSWORD=

# Shared secrets: long random strings (e.g. openssl rand -base64 48)
JWT_SECRET=
# pod-processor -> pod-connector credential requests; at least 16 characters
INTERNAL_API_TOKEN=
# pod-processor -> pod-sandbox
SANDBOX_TOKEN=
# Encrypts stored credentials: 32 random bytes, base64 (openssl rand -base64 32). Losing it
# means every connection has to be made again.
CONNECTIONS_ENCRYPTION_KEY=

# Public host names Caddy serves over HTTPS (each one's DNS must point at this machine; the
# *.localhost defaults get a local certificate, for trying the stack out)
API_HOST=api.localhost
HOOKS_HOST=hooks.localhost
CONNECT_HOST=connect.localhost

# Where the browser reaches the pods (on a server: https:// + the host names above; also compiled
# into the frontend image when it's built here)
PUBLIC_BACKEND_URL=http://localhost:8083
PUBLIC_WEBHOOKS_URL=http://localhost:8080
CONNECTOR_PUBLIC_URL=http://localhost:8084
# The app's address (CORS and OAuth redirects back to it)
FRONTEND_URL=http://localhost:3000
# The https address apps send trigger events to (pod-connector's /hooks/...)
TRIGGERS_PUBLIC_URL=

# OAuth apps (leave empty to hide that app's sign-in)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CALLBACK_URL=
SLACK_SIGNING_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Kafka: empty uses the stack's own broker. For a managed cluster (Aiven) also pass
# -f deploy/docker-compose.aiven.yml and set:
# KAFKA_BOOTSTRAP_SERVERS=host:port
# KAFKA_CERTS_DIR=/path/to/dir/with/ca.pem,service.cert,service.key

# Ports published directly (besides Caddy's 80/443), only on BIND_ADDRESS: 127.0.0.1 keeps them
# to this machine; 0.0.0.0 opens them to the network
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8083
WEBHOOKS_PORT=8080
CONNECTOR_PORT=8084
FRONTEND_PORT=3000

# Steps running at once across all runs (step-tasks partitions = worker threads). The stack's own
# broker has no limit; Aiven's smaller plans allow 2. Can be raised later, never lowered.
STEPS_TOPIC_PARTITIONS=8

# Code steps running at once
SANDBOX_CONCURRENCY=4
