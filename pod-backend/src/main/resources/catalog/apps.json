{
  "apps": [
    {
      "id": "app_webhook",
      "name": "Webhook",
      "description": "Start a workflow by calling its URL",
      "triggers": [
        {
          "id": "trg_webhook_catch",
          "name": "Catch Hook",
          "description": "Runs whenever the workflow's webhook URL receives a request; the request body is the trigger's data.",
          "fields": []
        }
      ],
      "actions": []
    },
    {
      "id": "app_http",
      "name": "HTTP",
      "description": "Call any HTTP API",
      "connectionOptional": true,
      "triggers": [],
      "actions": [
        {
          "id": "act_http_request",
          "name": "Make a Request",
          "description": "Calls a URL. 4xx/5xx responses fail the step; 5xx, 408, 429 and timeouts are retried.",
          "handler": "http_request",
          "fields": [
            { "key": "method", "label": "Method", "type": "select", "required": true, "defaultValue": "GET",
              "options": [
                { "value": "GET", "label": "GET" }, { "value": "POST", "label": "POST" },
                { "value": "PUT", "label": "PUT" }, { "value": "PATCH", "label": "PATCH" },
                { "value": "DELETE", "label": "DELETE" }
              ] },
            { "key": "url", "label": "URL", "type": "text", "required": true, "placeholder": "https://api.example.com/items" },
            { "key": "headers", "label": "Headers", "type": "keyvalue" },
            { "key": "body", "label": "Body", "type": "json",
              "help": "JSON is sent as application/json unless you set a Content-Type header; plain text is sent as-is." },
            { "key": "timeoutSeconds", "label": "Timeout (seconds)", "type": "number", "defaultValue": 30,
              "help": "At most 120." }
          ]
        }
      ]
    },
    {
      "id": "app_gmail",
      "name": "Gmail",
      "description": "Send and receive email",
      "triggers": [
        {
          "id": "trg_gmail_new_email",
          "name": "New Email",
          "description": "A new email arrives in the inbox.",
          "fields": [
            { "key": "from", "label": "From", "type": "text", "placeholder": "someone@example.com",
              "help": "Only emails from this address. Leave empty for all." }
          ]
        },
        {
          "id": "trg_gmail_new_attachment",
          "name": "New Attachment",
          "description": "A new email with an attachment arrives.",
          "fields": []
        },
        {
          "id": "trg_gmail_new_label",
          "name": "New Labeled Email",
          "description": "An email gets a label.",
          "fields": [
            { "key": "label", "label": "Label", "type": "text", "required": true, "placeholder": "Invoices" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_gmail_send",
          "name": "Send Email",
          "description": "Sends an email from the connected account.",
          "handler": "gmail.send_email",
          "fields": [
            { "key": "to", "label": "To", "type": "text", "required": true, "placeholder": "someone@example.com",
              "help": "Separate several addresses with commas." },
            { "key": "cc", "label": "Cc", "type": "text" },
            { "key": "subject", "label": "Subject", "type": "text", "required": true },
            { "key": "body", "label": "Body", "type": "textarea", "required": true },
            { "key": "bodyType", "label": "Body format", "type": "select", "defaultValue": "text",
              "options": [ { "value": "text", "label": "Plain text" }, { "value": "html", "label": "HTML" } ] }
          ]
        },
        {
          "id": "act_gmail_draft",
          "name": "Create Draft",
          "description": "Saves an email as a draft without sending it.",
          "handler": "gmail.create_draft",
          "fields": [
            { "key": "to", "label": "To", "type": "text", "placeholder": "someone@example.com" },
            { "key": "subject", "label": "Subject", "type": "text", "required": true },
            { "key": "body", "label": "Body", "type": "textarea", "required": true }
          ]
        }
      ]
    },
    {
      "id": "app_slack",
      "name": "Slack",
      "description": "Team messaging",
      "triggers": [
        {
          "id": "trg_slack_new_message",
          "name": "New Message in Channel",
          "description": "A message is posted in a channel.",
          "fields": [
            { "key": "channel", "label": "Channel", "type": "text", "required": true, "placeholder": "#general" }
          ]
        },
        {
          "id": "trg_slack_new_mention",
          "name": "New Mention",
          "description": "The connected user or bot is mentioned.",
          "fields": []
        }
      ],
      "actions": [
        {
          "id": "act_slack_post",
          "name": "Post Message",
          "description": "Posts a message to a channel.",
          "handler": "slack.post_message",
          "fields": [
            { "key": "channel", "label": "Channel", "type": "text", "required": true, "placeholder": "#general" },
            { "key": "text", "label": "Message", "type": "textarea", "required": true },
            { "key": "threadTs", "label": "Reply in thread", "type": "text",
              "help": "Timestamp of the message to reply to. Leave empty to post a new message." }
          ]
        },
        {
          "id": "act_slack_dm",
          "name": "Send Direct Message",
          "description": "Sends a direct message to one person.",
          "handler": "slack.send_dm",
          "fields": [
            { "key": "user", "label": "User", "type": "text", "required": true, "placeholder": "U012AB3CD or name@example.com" },
            { "key": "text", "label": "Message", "type": "textarea", "required": true }
          ]
        }
      ]
    },
    {
      "id": "app_sheets",
      "name": "Google Sheets",
      "description": "Spreadsheets",
      "triggers": [
        {
          "id": "trg_sheets_new_row",
          "name": "New Row",
          "description": "A row is added at the bottom of a sheet.",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" }
          ]
        },
        {
          "id": "trg_sheets_updated_row",
          "name": "Updated Row",
          "description": "A row in a sheet changes.",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_sheets_add_row",
          "name": "Add Row",
          "description": "Adds a row at the bottom of a sheet.",
          "handler": "sheets.add_row",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" },
            { "key": "values", "label": "Values", "type": "keyvalue", "required": true,
              "help": "Column header → value for the new row." }
          ]
        },
        {
          "id": "act_sheets_update_row",
          "name": "Update Row",
          "description": "Changes cells in one row.",
          "handler": "sheets.update_row",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" },
            { "key": "rowNumber", "label": "Row number", "type": "number", "required": true },
            { "key": "values", "label": "Values", "type": "keyvalue", "required": true,
              "help": "Column header → new value. Columns not listed are left as they are." }
          ]
        }
      ]
    },
    {
      "id": "app_github",
      "name": "GitHub",
      "description": "Repositories, issues and pull requests",
      "triggers": [
        {
          "id": "trg_github_new_issue",
          "name": "New Issue",
          "description": "An issue is opened in a repository.",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo" }
          ]
        },
        {
          "id": "trg_github_new_pr",
          "name": "New Pull Request",
          "description": "A pull request is opened in a repository.",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_github_create_issue",
          "name": "Create Issue",
          "description": "Opens an issue in a repository.",
          "handler": "github.create_issue",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo" },
            { "key": "title", "label": "Title", "type": "text", "required": true },
            { "key": "body", "label": "Body", "type": "textarea", "help": "Markdown is supported." },
            { "key": "labels", "label": "Labels", "type": "text", "placeholder": "bug, triage",
              "help": "Comma-separated. Labels that don't exist yet are created." }
          ]
        },
        {
          "id": "act_github_comment",
          "name": "Create Comment",
          "description": "Comments on an issue or pull request.",
          "handler": "github.create_comment",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo" },
            { "key": "issueNumber", "label": "Issue or PR number", "type": "number", "required": true },
            { "key": "body", "label": "Comment", "type": "textarea", "required": true, "help": "Markdown is supported." }
          ]
        }
      ]
    },
    {
      "id": "app_notion",
      "name": "Notion",
      "description": "Docs and databases",
      "triggers": [
        {
          "id": "trg_notion_new_page",
          "name": "New Page",
          "description": "A page is added to a database.",
          "fields": [
            { "key": "databaseId", "label": "Database ID", "type": "text", "required": true }
          ]
        },
        {
          "id": "trg_notion_updated_db",
          "name": "Updated Database Item",
          "description": "An item in a database changes.",
          "fields": [
            { "key": "databaseId", "label": "Database ID", "type": "text", "required": true }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_notion_create_page",
          "name": "Create Page",
          "description": "Creates a page in a database or under another page.",
          "handler": "notion.create_page",
          "fields": [
            { "key": "parentId", "label": "Parent database or page ID", "type": "text", "required": true },
            { "key": "title", "label": "Title", "type": "text", "required": true },
            { "key": "properties", "label": "Properties", "type": "json",
              "help": "Database properties in Notion's format, e.g. {\"Status\": {\"select\": {\"name\": \"Done\"}}}." },
            { "key": "content", "label": "Content", "type": "textarea" }
          ]
        },
        {
          "id": "act_notion_update_page",
          "name": "Update Page",
          "description": "Changes a page's properties.",
          "handler": "notion.update_page",
          "fields": [
            { "key": "pageId", "label": "Page ID", "type": "text", "required": true },
            { "key": "properties", "label": "Properties", "type": "json", "required": true,
              "help": "Properties to change, in Notion's format." }
          ]
        }
      ]
    },
    {
      "id": "app_stripe",
      "name": "Stripe",
      "description": "Payments",
      "triggers": [
        {
          "id": "trg_stripe_new_payment",
          "name": "New Payment",
          "description": "A payment succeeds.",
          "fields": []
        },
        {
          "id": "trg_stripe_new_customer",
          "name": "New Customer",
          "description": "A customer is created.",
          "fields": []
        }
      ],
      "actions": [
        {
          "id": "act_stripe_create_invoice",
          "name": "Create Invoice",
          "description": "Creates an invoice for a customer with one line item.",
          "handler": "stripe.create_invoice",
          "fields": [
            { "key": "customerId", "label": "Customer ID", "type": "text", "required": true, "placeholder": "cus_…" },
            { "key": "amount", "label": "Amount", "type": "number", "required": true,
              "help": "In the currency's smallest unit, e.g. cents: 1500 = $15.00." },
            { "key": "currency", "label": "Currency", "type": "text", "required": true, "defaultValue": "usd" },
            { "key": "description", "label": "Description", "type": "text" },
            { "key": "send", "label": "Send to the customer right away", "type": "boolean", "defaultValue": false }
          ]
        },
        {
          "id": "act_stripe_refund",
          "name": "Refund Payment",
          "description": "Refunds a payment in full or in part.",
          "handler": "stripe.refund_payment",
          "fields": [
            { "key": "paymentIntentId", "label": "Payment ID", "type": "text", "required": true, "placeholder": "pi_…" },
            { "key": "amount", "label": "Amount", "type": "number",
              "help": "In the smallest unit. Leave empty to refund everything." },
            { "key": "reason", "label": "Reason", "type": "select",
              "options": [
                { "value": "requested_by_customer", "label": "Requested by customer" },
                { "value": "duplicate", "label": "Duplicate" },
                { "value": "fraudulent", "label": "Fraudulent" }
              ] }
          ]
        }
      ]
    },
    {
      "id": "app_discord",
      "name": "Discord",
      "description": "Community chat",
      "triggers": [
        {
          "id": "trg_discord_new_message",
          "name": "New Message",
          "description": "A message is posted in a channel.",
          "fields": [
            { "key": "channelId", "label": "Channel ID", "type": "text", "required": true }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_discord_post",
          "name": "Send Channel Message",
          "description": "Posts a message in a channel.",
          "handler": "discord.send_message",
          "fields": [
            { "key": "channelId", "label": "Channel ID", "type": "text", "required": true },
            { "key": "content", "label": "Message", "type": "textarea", "required": true }
          ]
        }
      ]
    },
    {
      "id": "app_trello",
      "name": "Trello",
      "description": "Boards, lists and cards",
      "triggers": [
        {
          "id": "trg_trello_new_card",
          "name": "New Card",
          "description": "A card is added to a board.",
          "fields": [
            { "key": "boardId", "label": "Board ID", "type": "text", "required": true },
            { "key": "listId", "label": "List ID", "type": "text", "help": "Only cards in this list. Leave empty for the whole board." }
          ]
        },
        {
          "id": "trg_trello_card_moved",
          "name": "Card Moved to List",
          "description": "A card is moved into a list.",
          "fields": [
            { "key": "boardId", "label": "Board ID", "type": "text", "required": true },
            { "key": "listId", "label": "List ID", "type": "text", "required": true }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_trello_create_card",
          "name": "Create Card",
          "description": "Adds a card to a list.",
          "handler": "trello.create_card",
          "fields": [
            { "key": "listId", "label": "List ID", "type": "text", "required": true },
            { "key": "name", "label": "Name", "type": "text", "required": true },
            { "key": "description", "label": "Description", "type": "textarea" }
          ]
        },
        {
          "id": "act_trello_move_card",
          "name": "Move Card",
          "description": "Moves a card to another list.",
          "handler": "trello.move_card",
          "fields": [
            { "key": "cardId", "label": "Card ID", "type": "text", "required": true },
            { "key": "listId", "label": "Destination list ID", "type": "text", "required": true }
          ]
        }
      ]
    }
  ]
}
