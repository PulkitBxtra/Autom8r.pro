          "fields": [
            { "key": "parentId", "label": "Parent database or page", "type": "text", "required": true, "optionsFrom": "notion.parents" },
            { "key": "title", "label": "Title", "type": "text", "required": true },
            { "key": "properties", "label": "Properties", "type": "json",
              "help": "Database properties in Notion's format, e.g. {\"Status\": {\"select\": {\"name\": \"Done\"}}}." },
            { "key": "content", "label": "Content", "type": "textarea" }
          ],
          "outputs": [
            { "key": "id", "label": "Page ID", "type": "text" },
            { "key": "url", "label": "Page URL", "type": "text" },
            { "key": "parent", "label": "Created in (database or page)", "type": "text" }
          ]
        },
        {
          "id": "act_notion_update_page",
          "name": "Update Page",
          "description": "Changes a page's properties.",
          "handler": "notion.update_page",
          "fields": [
            { "key": "pageId", "label": "Page", "type": "text", "required": true, "optionsFrom": "notion.pages" },
            { "key": "properties", "label": "Properties", "type": "json", "required": true,
              "help": "Properties to change, in Notion's format." }
          ],
          "outputs": [
            { "key": "id", "label": "Page ID", "type": "text" },
            { "key": "url", "label": "Page URL", "type": "text" },
            { "key": "lastEditedTime", "label": "Last edited at", "type": "datetime" }
          ]
        }
      ]
    },
    {
      "id": "app_stripe",
