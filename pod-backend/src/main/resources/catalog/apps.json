{
  "apps": [
    {
      "id": "app_webhook",
      "name": "Webhook",
      "description": "Start a workflow by calling its URL",
      "triggers": [
        {
          "id": "trg_webhook_catch",
          "name": "Catch Hook",
          "description": "Runs whenever the workflow's webhook URL receives a request; the request body is the trigger's data.",
          "fields": []
        }
      ],
      "actions": []
    },
    {
      "id": "app_http",
      "name": "HTTP",
      "description": "Call any HTTP API",
      "connection": "optional",
      "triggers": [],
      "actions": [
        {
          "id": "act_http_request",
          "name": "Make a Request",
          "description": "Calls a URL. 4xx/5xx responses fail the step; 5xx, 408, 429 and timeouts are retried.",
          "handler": "http_request",
          "fields": [
            { "key": "method", "label": "Method", "type": "select", "required": true, "defaultValue": "GET",
              "options": [
                { "value": "GET", "label": "GET" }, { "value": "POST", "label": "POST" },
                { "value": "PUT", "label": "PUT" }, { "value": "PATCH", "label": "PATCH" },
                { "value": "DELETE", "label": "DELETE" }
              ] },
            { "key": "url", "label": "URL", "type": "text", "required": true, "placeholder": "https://api.example.com/items" },
            { "key": "headers", "label": "Headers", "type": "keyvalue", "secret": true,
              "help": "Values of headers like Authorization or X-Api-Key are hidden once saved. For credentials you reuse, add an HTTP connection instead." },
            { "key": "body", "label": "Body", "type": "json",
              "help": "JSON is sent as application/json unless you set a Content-Type header; plain text is sent as-is." },
            { "key": "timeoutSeconds", "label": "Timeout (seconds)", "type": "number", "defaultValue": 30,
              "help": "At most 120." }
          ],
          "outputs": [
            { "key": "status", "label": "Status code", "type": "number" },
            { "key": "body", "label": "Response body", "type": "any" }
          ]
        }
      ]
    },
    {
      "id": "app_logic",
      "name": "Logic",
      "description": "Branch, route and filter",
      "triggers": [],
      "actions": [
        {
          "id": "act_logic_switch",
          "name": "Switch",
          "description": "Checks paths in order and follows the first that matches; if none does, follows Otherwise.",
          "handler": "logic.switch",
          "fields": [
            { "key": "paths", "label": "Paths", "type": "paths", "required": true, "defaultValue": [ { "id": "p_a", "name": "Path A", "match": "all", "conditions": [ { "left": "", "op": "equals", "right": "" } ] } ] }
          ],
          "outputs": [
            { "key": "matched", "label": "Path taken", "type": "list" }
          ]
        },
        {
          "id": "act_logic_paths",
          "name": "Paths",
          "description": "Follows every path whose conditions match. If none match, nothing after it runs.",
          "handler": "logic.paths",
          "fields": [
            { "key": "paths", "label": "Paths", "type": "paths", "required": true, "defaultValue": [ { "id": "p_a", "name": "Path A", "match": "all", "conditions": [ { "left": "", "op": "equals", "right": "" } ] } ] }
          ],
          "outputs": [
            { "key": "matched", "label": "Paths taken", "type": "list" }
          ]
        },
        {
          "id": "act_logic_if_else",
          "name": "If / Else",
          "description": "Follows If when the conditions match, otherwise Else.",
          "handler": "logic.if_else",
          "fields": [
            { "key": "conditions", "label": "If", "type": "conditions", "required": true, "defaultValue": { "match": "all", "conditions": [ { "left": "", "op": "equals", "right": "" } ] } }
          ],
          "outputs": [
            { "key": "matched", "label": "Branch taken", "type": "list" }
          ]
        },
        {
          "id": "act_logic_filter",
          "name": "Filter",
          "description": "Continues only when the conditions match; otherwise the steps after it are skipped and the run still succeeds.",
          "handler": "logic.filter",
          "fields": [
            { "key": "conditions", "label": "Continue only if", "type": "conditions", "required": true, "defaultValue": { "match": "all", "conditions": [ { "left": "", "op": "equals", "right": "" } ] } }
          ],
          "outputs": [
            { "key": "matched", "label": "Continued", "type": "list" }
          ]
        }
      ]
    },
    {
      "id": "app_code",
      "name": "Code",
      "description": "Run your own Groovy script",
      "triggers": [],
      "actions": [
        {
          "id": "act_code_groovy",
          "name": "Run Groovy",
          "description": "Runs a Groovy script on the data you give it and returns what it computes. Scripts work on data only: no files, network or threads (use an HTTP step to call APIs).",
          "handler": "code.groovy",
          "outputsFrom": "outputs",
          "fields": [
            { "key": "inputs", "label": "Inputs", "type": "variables",
              "help": "Each name becomes a variable in the script. Values can use data from earlier steps." },
            { "key": "script", "label": "Script", "type": "code", "required": true,
              "defaultValue": "// Inputs are variables here, e.g. amount.\n// Return a map: its keys are this step's outputs.\nreturn [result: 'Hello']\n",
              "help": "Groovy. Return a map whose keys match the outputs below; println output is kept as Printed output." },
            { "key": "outputs", "label": "Outputs", "type": "outputs",
              "defaultValue": [ { "key": "result", "label": "Result", "type": "text" } ],
              "help": "What the script returns, so later steps can pick it from the data list. A value of the wrong type fails the step." },
            { "key": "timeoutSeconds", "label": "Timeout (seconds)", "type": "number", "defaultValue": 10,
              "help": "At most 30." }
          ],
          "outputs": [
            { "key": "logs", "label": "Printed output", "type": "text" }
          ]
        }
      ]
    },
    {
      "id": "app_gmail",
      "name": "Gmail",
      "description": "Send and receive email",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_gmail_new_email",
          "name": "New Email",
          "comingSoon": true,
          "description": "A new email arrives in the inbox.",
          "fields": [
            { "key": "from", "label": "From", "type": "text", "placeholder": "someone@example.com",
              "help": "Only emails from this address. Leave empty for all." }
          ]
        },
        {
          "id": "trg_gmail_new_attachment",
          "name": "New Attachment",
          "comingSoon": true,
          "description": "A new email with an attachment arrives.",
          "fields": []
        },
        {
          "id": "trg_gmail_new_label",
          "name": "New Labeled Email",
          "comingSoon": true,
          "description": "An email gets a label.",
          "fields": [
            { "key": "label", "label": "Label", "type": "text", "required": true, "placeholder": "Invoices" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_gmail_send",
          "name": "Send Email",
          "comingSoon": true,
          "description": "Sends an email from the connected account.",
          "handler": "gmail.send_email",
          "fields": [
            { "key": "to", "label": "To", "type": "text", "required": true, "placeholder": "someone@example.com",
              "help": "Separate several addresses with commas." },
            { "key": "cc", "label": "Cc", "type": "text" },
            { "key": "subject", "label": "Subject", "type": "text", "required": true },
            { "key": "body", "label": "Body", "type": "textarea", "required": true },
            { "key": "bodyType", "label": "Body format", "type": "select", "defaultValue": "text",
              "options": [ { "value": "text", "label": "Plain text" }, { "value": "html", "label": "HTML" } ] }
          ]
        },
        {
          "id": "act_gmail_draft",
          "name": "Create Draft",
          "comingSoon": true,
          "description": "Saves an email as a draft without sending it.",
          "handler": "gmail.create_draft",
          "fields": [
            { "key": "to", "label": "To", "type": "text", "placeholder": "someone@example.com" },
            { "key": "subject", "label": "Subject", "type": "text", "required": true },
            { "key": "body", "label": "Body", "type": "textarea", "required": true }
          ]
        }
      ]
    },
    {
      "id": "app_slack",
      "name": "Slack",
      "description": "Team messaging",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_slack_new_message",
          "name": "New Message in Channel",
          "description": "A message is posted in a channel.",
          "fields": [
            { "key": "channel", "label": "Channel", "type": "text", "required": true, "placeholder": "#general", "optionsFrom": "slack.channels" }
          ],
          "outputs": [
            { "key": "text", "label": "Message text", "type": "text" },
            { "key": "user", "label": "Posted by (user ID)", "type": "text" },
            { "key": "channel", "label": "Channel ID", "type": "text" },
            { "key": "channelName", "label": "Channel name", "type": "text" },
            { "key": "ts", "label": "Message timestamp", "type": "text" },
            { "key": "threadTs", "label": "Thread timestamp", "type": "text" },
            { "key": "team", "label": "Workspace", "type": "text" },
            { "key": "files", "label": "Attached file names", "type": "list" }
          ]
        },
        {
          "id": "trg_slack_new_mention",
          "name": "New Mention",
          "description": "The connected user or bot is mentioned.",
          "fields": [],
          "outputs": [
            { "key": "text", "label": "Message text", "type": "text" },
            { "key": "user", "label": "Posted by (user ID)", "type": "text" },
            { "key": "channel", "label": "Channel ID", "type": "text" },
            { "key": "ts", "label": "Message timestamp", "type": "text" },
            { "key": "threadTs", "label": "Thread timestamp", "type": "text" },
            { "key": "team", "label": "Workspace", "type": "text" },
            { "key": "files", "label": "Attached file names", "type": "list" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_slack_post",
          "name": "Post Message",
          "description": "Posts a message to a channel.",
          "handler": "slack.post_message",
          "fields": [
            { "key": "channel", "label": "Channel", "type": "text", "required": true, "placeholder": "#general", "optionsFrom": "slack.channels" },
            { "key": "text", "label": "Message", "type": "textarea", "required": true },
            { "key": "threadTs", "label": "Reply in thread", "type": "text",
              "help": "Timestamp of the message to reply to. Leave empty to post a new message." }
          ],
          "outputs": [
            { "key": "channel", "label": "Channel ID", "type": "text" },
            { "key": "ts", "label": "Message timestamp", "type": "text" },
            { "key": "text", "label": "Message text", "type": "text" }
          ]
        },
        {
          "id": "act_slack_dm",
          "name": "Send Direct Message",
          "description": "Sends a direct message to one person.",
          "handler": "slack.send_dm",
          "fields": [
            { "key": "user", "label": "User", "type": "text", "required": true, "placeholder": "U012AB3CD or name@example.com", "optionsFrom": "slack.users" },
            { "key": "text", "label": "Message", "type": "textarea", "required": true }
          ],
          "outputs": [
            { "key": "channel", "label": "DM channel ID", "type": "text" },
            { "key": "ts", "label": "Message timestamp", "type": "text" },
            { "key": "user", "label": "Recipient (user ID)", "type": "text" }
          ]
        }
      ]
    },
    {
      "id": "app_sheets",
      "name": "Google Sheets",
      "description": "Spreadsheets",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_sheets_new_row",
          "name": "New Row",
          "comingSoon": true,
          "description": "A row is added at the bottom of a sheet.",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" }
          ]
        },
        {
          "id": "trg_sheets_updated_row",
          "name": "Updated Row",
          "comingSoon": true,
          "description": "A row in a sheet changes.",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_sheets_add_row",
          "name": "Add Row",
          "comingSoon": true,
          "description": "Adds a row at the bottom of a sheet.",
          "handler": "sheets.add_row",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" },
            { "key": "values", "label": "Values", "type": "keyvalue", "required": true,
              "help": "Column header → value for the new row." }
          ]
        },
        {
          "id": "act_sheets_update_row",
          "name": "Update Row",
          "comingSoon": true,
          "description": "Changes cells in one row.",
          "handler": "sheets.update_row",
          "fields": [
            { "key": "spreadsheetId", "label": "Spreadsheet ID", "type": "text", "required": true,
              "help": "The long ID in the sheet's URL, between /d/ and /edit." },
            { "key": "sheet", "label": "Sheet", "type": "text", "required": true, "defaultValue": "Sheet1" },
            { "key": "rowNumber", "label": "Row number", "type": "number", "required": true },
            { "key": "values", "label": "Values", "type": "keyvalue", "required": true,
              "help": "Column header → new value. Columns not listed are left as they are." }
          ]
        }
      ]
    },
    {
      "id": "app_github",
      "name": "GitHub",
      "description": "Repositories, issues and pull requests",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_github_new_issue",
          "name": "New Issue",
          "description": "An issue is opened in a repository.",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo", "optionsFrom": "github.repos" }
          ],
          "outputs": [
            { "key": "repository", "label": "Repository", "type": "text" },
            { "key": "number", "label": "Number", "type": "number" },
            { "key": "title", "label": "Title", "type": "text" },
            { "key": "body", "label": "Description", "type": "text" },
            { "key": "url", "label": "URL", "type": "text" },
            { "key": "author", "label": "Author (GitHub login)", "type": "text" },
            { "key": "labels", "label": "Labels", "type": "list" },
            { "key": "createdAt", "label": "Opened at", "type": "datetime" }
          ]
        },
        {
          "id": "trg_github_new_pr",
          "name": "New Pull Request",
          "description": "A pull request is opened in a repository.",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo", "optionsFrom": "github.repos" }
          ],
          "outputs": [
            { "key": "repository", "label": "Repository", "type": "text" },
            { "key": "number", "label": "Number", "type": "number" },
            { "key": "title", "label": "Title", "type": "text" },
            { "key": "body", "label": "Description", "type": "text" },
            { "key": "url", "label": "URL", "type": "text" },
            { "key": "author", "label": "Author (GitHub login)", "type": "text" },
            { "key": "labels", "label": "Labels", "type": "list" },
            { "key": "branch", "label": "Branch", "type": "text" },
            { "key": "baseBranch", "label": "Base branch", "type": "text" },
            { "key": "draft", "label": "Draft", "type": "boolean" },
            { "key": "createdAt", "label": "Opened at", "type": "datetime" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_github_create_issue",
          "name": "Create Issue",
          "description": "Opens an issue in a repository.",
          "handler": "github.create_issue",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo", "optionsFrom": "github.repos" },
            { "key": "title", "label": "Title", "type": "text", "required": true },
            { "key": "body", "label": "Body", "type": "textarea", "help": "Markdown is supported." },
            { "key": "labels", "label": "Labels", "type": "text", "placeholder": "bug, triage",
              "help": "Comma-separated. Labels that don't exist yet are created." }
          ],
          "outputs": [
            { "key": "number", "label": "Issue number", "type": "number" },
            { "key": "url", "label": "Issue URL", "type": "text" },
            { "key": "id", "label": "Issue ID", "type": "number" },
            { "key": "title", "label": "Title", "type": "text" },
            { "key": "state", "label": "State", "type": "text" },
            { "key": "labels", "label": "Labels", "type": "list" }
          ]
        },
        {
          "id": "act_github_comment",
          "name": "Create Comment",
          "description": "Comments on an issue or pull request.",
          "handler": "github.create_comment",
          "fields": [
            { "key": "repository", "label": "Repository", "type": "text", "required": true, "placeholder": "owner/repo", "optionsFrom": "github.repos" },
            { "key": "issueNumber", "label": "Issue or PR number", "type": "number", "required": true },
            { "key": "body", "label": "Comment", "type": "textarea", "required": true, "help": "Markdown is supported." }
          ],
          "outputs": [
            { "key": "id", "label": "Comment ID", "type": "number" },
            { "key": "url", "label": "Comment URL", "type": "text" },
            { "key": "issueNumber", "label": "Issue number", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": "app_notion",
      "name": "Notion",
      "description": "Docs and databases",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_notion_new_page",
          "name": "New Page",
          "description": "A page is added to a database.",
