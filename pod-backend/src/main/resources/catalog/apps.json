        },
        {
          "id": "trg_stripe_new_customer",
          "name": "New Customer",
          "description": "A customer is created. Turning the workflow on adds a webhook endpoint to the Stripe account (a restricted key needs Webhook Endpoints: Write).",
          "fields": [],
          "outputs": [
            { "key": "id", "label": "Customer ID", "type": "text" },
            { "key": "name", "label": "Name", "type": "text" },
            { "key": "email", "label": "Email", "type": "text" },
            { "key": "phone", "label": "Phone", "type": "text" },
            { "key": "description", "label": "Description", "type": "text" },
            { "key": "metadata", "label": "Metadata", "type": "object" },
            { "key": "createdAt", "label": "Created at", "type": "datetime" },
            { "key": "livemode", "label": "Live mode", "type": "boolean" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_stripe_create_invoice",
          "name": "Create Invoice",
          "description": "Creates an invoice for a customer with one line item. Sent right away, or left as a draft to review in Stripe.",
          "handler": "stripe.create_invoice",
          "fields": [
            { "key": "customerId", "label": "Customer", "type": "text", "required": true, "placeholder": "cus_…",
              "optionsFrom": "stripe.customers" },
            { "key": "amount", "label": "Amount", "type": "number", "required": true,
              "help": "In the currency's smallest unit, e.g. cents: 1500 = $15.00." },
            { "key": "currency", "label": "Currency", "type": "text", "required": true, "defaultValue": "usd",
              "help": "Three letters, e.g. usd, eur, inr." },
            { "key": "description", "label": "Description", "type": "text",
              "help": "Shown on the invoice and its line item." },
            { "key": "daysUntilDue", "label": "Days until due", "type": "number", "defaultValue": 30 },
            { "key": "send", "label": "Send to the customer right away", "type": "boolean", "defaultValue": false,
              "help": "Off: the invoice stays a draft in Stripe for you to check and send." }
          ],
          "outputs": [
            { "key": "id", "label": "Invoice ID", "type": "text" },
            { "key": "number", "label": "Invoice number", "type": "text" },
            { "key": "status", "label": "Status (draft, open...)", "type": "text" },
            { "key": "url", "label": "Payment page link", "type": "text" },
            { "key": "amountDue", "label": "Amount due (smallest unit)", "type": "number" },
            { "key": "currency", "label": "Currency", "type": "text" },
            { "key": "customerId", "label": "Customer ID", "type": "text" }
          ]
        },
        {
          "id": "act_stripe_refund",
          "name": "Refund Payment",
          "description": "Refunds a payment in full or in part.",
          "handler": "stripe.refund_payment",
          "fields": [
            { "key": "paymentIntentId", "label": "Payment ID", "type": "text", "required": true, "placeholder": "pi_… or ch_…",
              "help": "Usually from the trigger or an earlier step." },
            { "key": "amount", "label": "Amount", "type": "number",
              "help": "In the smallest unit. Leave empty to refund everything that's left." },
            { "key": "reason", "label": "Reason", "type": "select",
              "options": [
                { "value": "requested_by_customer", "label": "Requested by customer" },
                { "value": "duplicate", "label": "Duplicate" },
                { "value": "fraudulent", "label": "Fraudulent" }
              ] }
          ],
          "outputs": [
            { "key": "id", "label": "Refund ID", "type": "text" },
            { "key": "status", "label": "Status (succeeded, pending...)", "type": "text" },
            { "key": "amount", "label": "Amount refunded (smallest unit)", "type": "number" },
            { "key": "currency", "label": "Currency", "type": "text" },
            { "key": "paymentIntentId", "label": "Payment ID", "type": "text" }
          ]
        }
      ]
    },
    {
      "id": "app_discord",
      "name": "Discord",
      "description": "Community chat",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_discord_new_message",
          "name": "New Message",
          "comingSoon": true,
          "description": "A message is posted in a channel.",
          "fields": [
            { "key": "channelId", "label": "Channel ID", "type": "text", "required": true }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_discord_post",
          "name": "Send Channel Message",
          "description": "Posts a message in a channel as the bot. Users and roles it mentions are pinged; @everyone and @here are not.",
          "handler": "discord.send_message",
          "fields": [
            { "key": "channelId", "label": "Channel", "type": "text", "required": true, "placeholder": "Channel ID or link",
              "optionsFrom": "discord.channels",
              "help": "The bot must be in the server and allowed to send messages there." },
            { "key": "content", "label": "Message", "type": "textarea", "required": true,
              "help": "Up to 2000 characters. Markdown works." },
            { "key": "replyTo", "label": "Reply to message", "type": "text", "placeholder": "Message ID",
              "help": "Leave empty to post a new message." }
          ],
          "outputs": [
            { "key": "id", "label": "Message ID", "type": "text" },
            { "key": "channelId", "label": "Channel ID", "type": "text" },
            { "key": "content", "label": "Message text", "type": "text" },
            { "key": "timestamp", "label": "Posted at", "type": "datetime" }
          ]
        }
      ]
    },
    {
      "id": "app_trello",
      "name": "Trello",
      "description": "Boards, lists and cards",
      "connection": "required",
      "triggers": [
        {
          "id": "trg_trello_new_card",
          "name": "New Card",
          "description": "A card is added to a board. Turning the workflow on adds a webhook to the board.",
          "fields": [
            { "key": "boardId", "label": "Board", "type": "text", "required": true, "placeholder": "Board ID",
              "optionsFrom": "trello.boards" },
            { "key": "listId", "label": "List", "type": "text", "placeholder": "List ID", "optionsFrom": "trello.lists",
              "help": "Only cards added to this list. Leave empty for the whole board." }
          ],
          "outputs": [
            { "key": "id", "label": "Card ID", "type": "text" },
            { "key": "name", "label": "Card name", "type": "text" },
            { "key": "url", "label": "Card link", "type": "text" },
            { "key": "listId", "label": "List ID", "type": "text" },
            { "key": "listName", "label": "List name", "type": "text" },
            { "key": "boardId", "label": "Board ID", "type": "text" },
            { "key": "boardName", "label": "Board name", "type": "text" },
            { "key": "by", "label": "By (member name)", "type": "text" },
            { "key": "at", "label": "When", "type": "datetime" }
          ]
        },
        {
          "id": "trg_trello_card_moved",
          "name": "Card Moved to List",
          "description": "A card is moved into a list. Turning the workflow on adds a webhook to the list's board.",
          "fields": [
            { "key": "listId", "label": "List", "type": "text", "required": true, "placeholder": "List ID",
              "optionsFrom": "trello.lists" }
          ],
          "outputs": [
            { "key": "id", "label": "Card ID", "type": "text" },
            { "key": "name", "label": "Card name", "type": "text" },
            { "key": "url", "label": "Card link", "type": "text" },
            { "key": "fromListId", "label": "Moved from (list ID)", "type": "text" },
            { "key": "fromListName", "label": "Moved from (list name)", "type": "text" },
            { "key": "listId", "label": "Moved to (list ID)", "type": "text" },
            { "key": "listName", "label": "Moved to (list name)", "type": "text" },
            { "key": "boardId", "label": "Board ID", "type": "text" },
            { "key": "boardName", "label": "Board name", "type": "text" },
            { "key": "by", "label": "By (member name)", "type": "text" },
            { "key": "at", "label": "When", "type": "datetime" }
          ]
        }
      ],
      "actions": [
        {
          "id": "act_trello_create_card",
          "name": "Create Card",
          "description": "Adds a card to a list.",
          "handler": "trello.create_card",
          "fields": [
            { "key": "listId", "label": "List", "type": "text", "required": true, "placeholder": "List ID",
              "optionsFrom": "trello.lists" },
            { "key": "name", "label": "Name", "type": "text", "required": true },
            { "key": "description", "label": "Description", "type": "textarea", "help": "Markdown works." },
            { "key": "position", "label": "Position", "type": "select", "defaultValue": "bottom",
              "options": [ { "value": "bottom", "label": "Bottom of the list" }, { "value": "top", "label": "Top of the list" } ] },
            { "key": "due", "label": "Due date", "type": "text", "placeholder": "2026-10-31 or 2026-10-31T17:00:00Z",
              "help": "A date (midnight UTC), or a date and time with a time zone." }
          ],
          "outputs": [
            { "key": "id", "label": "Card ID", "type": "text" },
            { "key": "name", "label": "Card name", "type": "text" },
            { "key": "url", "label": "Card link", "type": "text" },
            { "key": "listId", "label": "List ID", "type": "text" },
            { "key": "boardId", "label": "Board ID", "type": "text" }
          ]
        },
        {
          "id": "act_trello_move_card",
          "name": "Move Card",
          "description": "Moves a card to another list, on the same board or another one.",
          "handler": "trello.move_card",
          "fields": [
            { "key": "cardId", "label": "Card", "type": "text", "required": true, "placeholder": "Card ID or link",
              "help": "Usually from an earlier step, e.g. Create Card's Card ID, or a link like https://trello.com/c/AbCd1234." },
            { "key": "listId", "label": "Move to list", "type": "text", "required": true, "placeholder": "List ID",
              "optionsFrom": "trello.lists" },
            { "key": "position", "label": "Position", "type": "select", "defaultValue": "bottom",
              "options": [ { "value": "bottom", "label": "Bottom of the list" }, { "value": "top", "label": "Top of the list" } ] }
          ],
          "outputs": [
            { "key": "id", "label": "Card ID", "type": "text" },
            { "key": "name", "label": "Card name", "type": "text" },
            { "key": "url", "label": "Card link", "type": "text" },
            { "key": "listId", "label": "List ID", "type": "text" },
            { "key": "boardId", "label": "Board ID", "type": "text" }
          ]
        }
      ]
    }
  ]
}
